# Base URL Sanka API (otakudesu wrapper). Defaultnya udah bener, biasanya
# nggak perlu diisi kecuali mau ganti/self-host.
# SANKA_API_BASE=https://www.sankavollerei.web.id/anime

# Isi ini HANYA kalau Vercel kena 403 dari Sanka API/otakudesu.
# Isi dengan URL Cloudflare Worker reverse-proxy (lihat cloudflare-worker-proxy.js
# di root project ini + panduan di README).
SANKA_API_FALLBACK=
